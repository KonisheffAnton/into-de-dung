# ---------------------------------------------------------------------------
# Godot 4+
# ---------------------------------------------------------------------------
# Кэш движка и сгенерированные импорт-данные. НИКОГДА не коммитить:
# .godot/ пересобирается автоматически и создаёт сотни мусорных диффов.
.godot/
.import/

# Экспортные пресеты могут содержать пути к кейстору/паролям.
export_presets.cfg
export.cfg

# Собранные билды
/build/
/builds/
/export/
/android/
/ios/

# ---------------------------------------------------------------------------
# Бинарные артефакты сборки
# ---------------------------------------------------------------------------
*.pck
*.zip
*.exe
*.apk
*.aab
*.dmg
*.app
*.so
*.dylib
*.dll
*.tmp
*.translation

# ---------------------------------------------------------------------------
# Mono / C# (не используется сейчас, но на случай добавления)
# ---------------------------------------------------------------------------
.mono/
data_*/
mono_crash.*.json
/bin/
/obj/
*.csproj
*.sln

# ---------------------------------------------------------------------------
# IDE / редакторы
# ---------------------------------------------------------------------------
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# VS Code: настройки проекта коммитим, локальный мусор — нет.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# ---------------------------------------------------------------------------
# ОС
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Отчёты тестов (gdUnit4 / GUT)
# ---------------------------------------------------------------------------
/reports/
/test_reports/
