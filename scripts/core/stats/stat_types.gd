extends RefCounted
class_name StatTypes

## Единый enum типов характеристик. Новые статы добавляются здесь и сразу
## доступны через StatsComponent без изменения его кода (Dictionary-based).

enum StatType {
	HP,             ## Текущий запас здоровья.
	HP_MAX,         ## Максимальный запас здоровья.
	INITIATIVE,     ## Определяет порядок ходов (выше = ходит раньше).
	BALANCE,        ## Текущее накопление шкалы Баланса (0 = устойчив).
	BALANCE_MAX,    ## Порог, при достижении которого юнит теряет равновесие/толкается.
	STRENGTH,       ## Сила — напрямую влияет на урон атак (Damage System, Модуль 6).
	IMPACT_POWER,   ## Сила импакта — влияет на накопление Баланса цели и толкание.
	MOVE_RANGE,     ## Дальность хода в очках движения (для Pathfinding).
}
