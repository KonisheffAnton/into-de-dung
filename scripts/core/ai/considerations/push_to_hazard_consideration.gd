extends AIConsideration
class_name PushToHazardConsideration

## Максимальная оценка, если толчок сбрасывает цель в пропасть/лаву —
## мгновенное устранение врага без траты урона.
##
## ИЗМЕНЕНО НА ШАГЕ 0.4: теперь фактор спрашивает у `PushResult` исход
## (`FELL`), а не сверяет клетку со списком `hazard_cells` вручную. Это
## важнее, чем кажется: `PushResolver` учитывает ещё и вылет ЗА КРАЙ доски
## (`REASON_BOUNDS`), который в списке опасных клеток отсутствует по
## определению — их там просто нет, доска заканчивается. Раньше такой толчок
## оценивался как обычное перемещение.
##
## Также сохранено: `has_attack()` вместо сравнения со строкой (S-3б),
## `ABSTAIN` вместо `0.0` для неприменимых кандидатов (S-3в).

func score(action: AIAction, context: AIDecisionContext) -> float:
	if not action.has_attack():
		return ABSTAIN

	var info := action.damage_info

	# Баланс не сломается — толчка не будет, фактору нечего сказать.
	# (Раньше здесь возвращался 0.0, то есть фактор активно голосовал ПРОТИВ
	# любой атаки, которая не ломает баланс — а таких большинство.)
	if not info.would_break_balance or info.push_result == null:
		return ABSTAIN

	# Цель улетает в пропасть или за край доски — лучший возможный исход.
	if info.push_result.is_lethal():
		return 1.0

	# Толчок упёрся (стена/юнит) — это оценивают другие факторы.
	if not info.push_result.moved():
		return ABSTAIN

	# Резервная проверка по списку опасных клеток: нужна, если контекст
	# построен без доски (unit-тесты) и резолвер не смог определить исход.
	if context.is_hazard(info.push_result.final_cell):
		return 1.0

	# Толчок есть, но в безопасную клетку — фактор высказался: ценности нет.
	return 0.0
