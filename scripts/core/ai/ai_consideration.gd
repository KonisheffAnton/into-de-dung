extends Resource
class_name AIConsideration

## Абстрактная база Utility AI "фактора оценки" (Strategy-подобный паттерн,
## как `TurnOrderStrategy` в модуле 4). Каждый конкретный фактор — отдельный
## небольшой Resource-скрипт, оценивающий ОДНУ грань кандидата `AIAction` в
## диапазоне [0..1]. Новые типы поведения добавляются созданием нового
## фактора + подключением в `AIBehaviorProfile.tres`, без изменения
## `UtilityAIController`. (Сохранённое решение модуля 7.)
##
## `weight` настраивается ПО ЭКЗЕМПЛЯРУ (в конкретном `.tres`), поэтому один
## и тот же фактор может иметь разный вес у разных ролей врагов
## (Aggressor/Blocker) без дублирования кода. (Сохранено.)
##
## ЧТО ИСПРАВЛЕНО — ДЕФЕКТ S-3в ("нет мнения" != "оценка ноль").
##
## Раньше фактор, не имеющий отношения к кандидату, возвращал `0.0`. При
## взвешенном СРЕДНЕМ это не нейтральное значение, а активный ГОЛОС ПРОТИВ.
## Реальное последствие: в `aggressor_profile.tres` три фактора из четырёх
## (LowHpTarget, BalanceExploit, PushToHazard) возвращали 0 для любого
## действия `move`. Поэтому ЛЮБАЯ атака получала оценку заведомо выше ЛЮБОГО
## перемещения, независимо от тактической ценности, и профиль "Агрессор"
## фактически не умел выбирать позицию — он умел только "атаковать, если
## дотянусь". Настройка весов в `.tres` при этом работала не так, как ожидал
## бы дизайнер: нули сидели в знаменателе и размывали веса.
##
## Решение: три РАЗНЫХ исхода вместо одного числа.
##  - обычная оценка [0..1] — фактор высказался;
##  - `ABSTAIN` — фактор не имеет мнения, исключается из знаменателя;
##  - `VETO` — действие недопустимо (встать в лаву, толкнуть союзника
##    в пропасть). Обнуляет кандидата целиком, без "размывания" средним.
##
## "Нет мнения": кандидат не относится к этому фактору. NAN выбран потому,
## что его нельзя случайно перепутать с валидной оценкой и он сам
## "заражает" арифметику, если забыть его отфильтровать (ошибка станет
## заметной, а не тихой).
const ABSTAIN: float = NAN

## "Запрещено": кандидат должен быть отброшен целиком.
const VETO: float = -1.0

@export var weight: float = 1.0


## action: кандидат хода/атаки, который нужно оценить.
## context: общий снимок ситуации (см. `AIDecisionContext`).
## Возвращает [0..1], либо `ABSTAIN`, либо `VETO`. Переопределяется в наследниках.
func score(_action: AIAction, _context: AIDecisionContext) -> float:
	push_error("AIConsideration.score() is abstract, override in a subclass")
	return ABSTAIN


static func is_abstain(value: float) -> bool:
	return is_nan(value)


static func is_veto(value: float) -> bool:
	return value < 0.0
