extends RefCounted
class_name UnitId

## Стабильный идентификатор юнита (R-4).
##
## ЗАЧЕМ: до рефакторинга юнит идентифицировался ссылкой на StatsComponent
## (дефект C-1) — "мешок характеристик" был первичным ключом личности. Это
## делало невозможными сериализацию (ссылку на Node не сохранить), реестр
## occupancy на доске, реплеи и детерминированные тай-брейки.
##
## Реализован как ПРОСТОЕ ЦЕЛОЕ ЧИСЛО (`int`), а не как объект-обёртка:
## id кладётся в ключи Dictionary (occupancy доски) и сравнивается в горячих
## циклах ИИ — объект-обёртка давала бы аллокацию и сравнение по ссылке
## вместо значения. Здесь только статические хелперы и константы.
##
## Значения выдаются возрастающей последовательностью в рамках одного боя.
## Сохраняется вместе с боем, поэтому счётчик тоже должен попадать в сейв
## (см. reset_counter/set_counter).

## Зарезервированное значение "нет юнита" (пустая клетка, отсутствующая цель).
const NONE: int = 0

## Первый выдаваемый идентификатор.
const FIRST: int = 1

static var _next_id: int = FIRST


## Выдаёт новый уникальный идентификатор.
static func next() -> int:
	var id := _next_id
	_next_id += 1
	return id


static func is_valid(id: int) -> bool:
	return id >= FIRST


## Сбрасывает счётчик (новый бой). Вызывать ТОЛЬКО когда все предыдущие
## UnitState уничтожены, иначе получим коллизию идентификаторов.
static func reset_counter() -> void:
	_next_id = FIRST


## --- Сериализация счётчика (R-4) -------------------------------------------
## Счётчик обязан сохраняться: если после загрузки он начнёт с 1, новый юнит
## получит id уже существующего и перезапишет его в occupancy доски.

static func get_counter() -> int:
	return _next_id


static func set_counter(value: int) -> void:
	_next_id = maxi(value, FIRST)
