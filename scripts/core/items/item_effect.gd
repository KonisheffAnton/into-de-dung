extends Resource
class_name ItemEffect

## Абстрактная база эффекта предмета. Конкретные предметы (Item) состоят
## из массива ItemEffect — композиция вместо наследования "класс на каждый
## айтем": один и тот же тип эффекта (например StatModifierEffect) можно
## переиспользовать в десятках предметов с разными параметрами.

## Вызывается при экипировке/получении предмета владельцем.
## owner — нода-владелец (юнит), stats — его StatsComponent (может быть null,
## если у владельца нет статов — тогда эффект просто не применяет модификаторы).
func on_equip(owner: Node, stats: StatsComponent) -> void:
	pass # virtual, переопределяется в наследниках


## Вызывается при снятии/потере предмета. Обязан отменить всё, что сделал
## on_equip (например снять модификаторы, отписаться от GameEventBus).
func on_unequip(owner: Node, stats: StatsComponent) -> void:
	pass # virtual, переопределяется в наследниках
