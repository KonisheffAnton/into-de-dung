extends Resource
class_name ItemEffect

## Абстрактная база эффекта предмета. Конкретные предметы (`Item`) состоят из
## массива `ItemEffect` — композиция вместо "класс на каждый айтем": один тип
## эффекта (например `StatModifierEffect`) переиспользуется в десятках
## предметов с разными параметрами. (Сохранённое решение модуля 5.)
##
## ⚠️ ЭТОТ ФАЙЛ БУДЕТ ПЕРЕДЕЛАН НА ШАГЕ 0.8 (дефект C-3, правило R-1).
##
## Текущая модель нарушает R-1: `ItemEffect` — это `Resource`, то есть
## РАЗДЕЛЯЕМЫЙ кэшированный объект, но наследники (`TriggeredEffect`) хранят
## в нём состояние КОНКРЕТНОГО владельца. Выдача одного предмета двум юнитам
## приводит к перезатиранию владельца и к hard error Godot
## ("Signal is already connected to given callable").
##
## Целевая модель: `ItemEffectDef : Resource` (только параметры) +
## `ItemEffectRuntime : RefCounted` (владелец, подписки, состояние), плюс
## `EffectContext` вместо текущей протекающей сигнатуры (дефект D-5.1 —
## эффекту уже не хватает доступа к доске, очереди действий и RNG).
##
## Сейчас выполнена только МИНИМАЛЬНАЯ миграция на `UnitState`, чтобы проект
## компилировался: полный split отложен до шага 0.8, потому что он завязан на
## систему награды за бой, которой ещё нет (R-7 — не переделывать то, что
## нельзя проверить в игровом цикле).

## Вызывается при экипировке/получении предмета владельцем.
func on_equip(_unit: UnitState) -> void:
	pass # virtual, переопределяется в наследниках


## Вызывается при снятии/потере предмета. Обязан отменить всё, что сделал
## `on_equip` (снять модификаторы, отписаться от событий).
func on_unequip(_unit: UnitState) -> void:
	pass # virtual, переопределяется в наследниках
